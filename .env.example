# Copiar a .env (ignorado por Git) y reemplazar los valores:  cp .env.example .env
# Nunca subir credenciales reales al repositorio.

# --- SQL Server (docker-compose) ---
# Política de SQL Server: mínimo 8 caracteres con mayúsculas, minúsculas, números y símbolos.
MSSQL_SA_PASSWORD=Cambiar_Esta_Clave_123!

# --- RabbitMQ (docker-compose) ---
RABBITMQ_USER=healthauth
RABBITMQ_PASSWORD=Cambiar_Esta_Clave_456!

# --- API (docker-compose) ---
# Clave HS256 para firmar los tokens de la demo: mínimo 32 bytes. Generar con:  openssl rand -base64 48
JWT_SIGNING_KEY=Reemplazar_Con_Una_Clave_Aleatoria_De_Al_Menos_32_Bytes
