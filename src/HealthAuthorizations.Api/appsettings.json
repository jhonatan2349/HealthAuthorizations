{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "UseUtcTimestamp": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ",
        "JsonWriterOptions": {
          "Indented": false
        }
      }
    }
  },
  "AllowedHosts": "*",
  "Cobertura": {
    "PorcentajeArs": 70
  },
  "MediatR": {
    "LicenseKey": ""
  },
  "Jwt": {
    "Issuer": "https://healthauthorizations.local",
    "Audience": "healthauthorizations-api",
    "MinutosVigencia": 60,
    "SigningKey": ""
  },
  "Auth": {
    "EmisorDemo": {
      "Habilitado": false
    }
  },
  "RateLimiting": {
    "PermisosPorMinuto": 300,
    "PermisosTokenPorMinuto": 10
  },
  "Cors": {
    "OrigenesPermitidos": []
  }
}
