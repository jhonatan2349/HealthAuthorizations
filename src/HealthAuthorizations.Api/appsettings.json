{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "Microsoft.AspNetCore.DataProtection": "Error"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "UseUtcTimestamp": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ",
        "JsonWriterOptions": {
          "Indented": false
        }
      }
    }
  },
  "AllowedHosts": "*",
  "Cobertura": {
    "PorcentajeArs": 70
  },
  "MediatR": {
    "LicenseKey": ""
  },
  "Jwt": {
    "Issuer": "https://healthauthorizations.local",
    "Audience": "healthauthorizations-api",
    "MinutosVigencia": 60,
    "SigningKey": ""
  },
  "Auth": {
    "EmisorDemo": {
      "Habilitado": false
    }
  },
  "RateLimiting": {
    "PermisosPorMinuto": 300,
    "PermisosTokenPorMinuto": 10
  },
  "Cors": {
    "OrigenesPermitidos": []
  },
  "ProxyInverso": {
    "Habilitado": false,
    "RedesConfiables": [],
    "MaximoSaltos": 1
  },
  "Resiliencia": {
    "TimeoutSolicitudSegundos": 30,
    "TimeoutApagadoSegundos": 25,
    "TimeoutComandoSqlSegundos": 30
  },
  "Mensajeria": {
    "Habilitada": false,
    "RabbitMq": {
      "Host": "localhost",
      "Puerto": 5672,
      "VirtualHost": "/",
      "Usuario": "",
      "Clave": "",
      "Exchange": "healthauthorizations.eventos"
    },
    "Outbox": {
      "IntervaloSegundos": 5,
      "TamanoLote": 50,
      "MaxIntentos": 10,
      "LeaseSegundos": 60
    }
  }
}
